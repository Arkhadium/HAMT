{
"version": "0.2.0",
"configurations": [
{
"name": "Déboguer hamt",
"type": "cppdbg",
"request": "launch",
"program": "${workspaceFolder}/build/hamt",
"args": [],
"stopAtEntry": false,
"cwd": "${workspaceFolder}",
"environment": [],
"externalConsole": false,
"MIMode": "gdb",
"miDebuggerPath": "/usr/bin/gdb",
"setupCommands": [
{
"description": "Activer le pretty-printing GDB",
"text": "-enable-pretty-printing",
"ignoreFailures": true
},
{
"description": "Utiliser la syntaxe assembleur Intel",
"text": "-gdb-set disassembly-flavor intel",
"ignoreFailures": true
}
]
}
]
}
